{
  "framework": null,
  "buildCommand": "pnpm run build -- --output-path dist",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/krishivlabs-blogs/:path*",
      "destination": "/krishivlabs-blogs/index.html"
    },
    {
      "source": "/indiaxguide/:path*",
      "destination": "/indiaxguide/index.html"
    }
  ]
}
